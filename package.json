{
  "name": "oprobots-telemetry-studio",
  "version": "0.1.0",
  "description": "Aplicación de escritorio para análisis de telemetría de robots OPRobots con vídeo sincronizado",
  "homepage": "https://github.com/robotaleh/OPRobots-TelemetryPlayer",
  "main": "./out/main/index.js",
  "author": "robotaleh",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "dev": "ELECTRON_DISABLE_SECURITY_WARNINGS=1 FONTCONFIG_FILE=scripts/fonts.conf electron-vite dev",
    "build": "electron-vite build",
    "preview": "FONTCONFIG_PATH=/dev/null electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/run-electron.mjs scripts/smoke-test.mjs",
    "e2e:serial": "node scripts/run-electron.mjs scripts/e2e-serial.mjs",
    "e2e:video": "node scripts/run-electron.mjs scripts/e2e-video.mjs",
    "e2e": "npm run e2e:serial && npm run e2e:video",
    "verify": "npm run typecheck && npm run test && npm run build && npm run smoke && npm run e2e",
    "lint": "eslint src/",
    "poc:1": "FONTCONFIG_PATH=/dev/null electron-vite dev --config pocs/01-serial-widget/electron.vite.config.ts",
    "poc:2": "FONTCONFIG_PATH=/dev/null electron-vite dev --config pocs/02-video-sync/electron.vite.config.ts",
    "poc:3": "FONTCONFIG_PATH=/dev/null electron-vite dev --config pocs/03-video-export/electron.vite.config.ts",
    "poc:4": "FONTCONFIG_PATH=/dev/null electron-vite dev --config pocs/04-packaging/electron.vite.config.ts",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@serialport/list": "^13.0.0",
    "electron-store": "^10.0.0",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^34.5.8",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "uplot": "^1.6.0",
    "vite": "^5.4.0",
    "vitest": "^3.0.0",
    "zustand": "^5.0.0"
  },
  "allowScripts": {
    "electron@34.5.8": true
  }
}
