{
  "name": "oprobots-poc4-packaging",
  "version": "0.1.0",
  "description": "PoC 4: Packaging test with serialport",
  "main": "./out/main/index.js",
  "author": "robotaleh",
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://github.com/robotaleh/OPRobots-TelemetryPlayer",
  "scripts": {
    "dev": "FONTCONFIG_PATH=/dev/null electron-vite dev --config electron.vite.config.ts",
    "build:linux": "FONTCONFIG_PATH=/dev/null electron-vite build --config electron.vite.config.ts && electron-builder --linux --config electron-builder.yml",
    "build:mac": "electron-vite build --config electron.vite.config.ts && electron-builder --mac --config electron-builder.yml",
    "build:win": "electron-vite build --config electron.vite.config.ts && electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^34.5.8",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "electron@34.5.8": true,
    "@serialport/bindings-cpp@13.0.0": true,
    "esbuild@0.21.5": true
  }
}
